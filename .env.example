# Copy to .env for local development. Never commit real secrets.
DB_DRIVER=pglite
PGLITE_DIR=./data/pglite
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# At least 32 characters; replace with a random value (e.g. `openssl rand -hex 32`).
SESSION_SECRET=replace-this-placeholder-with-32-or-more-random-chars
