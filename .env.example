# Copy to .env and edit. Never commit real secrets.
# Docker compose reads this file for the app service; it sets DB_DRIVER=pg and
# DATABASE_URL=postgres://dt:dt@db:5432/dt itself, so only the secrets below are required there.

# --- HTTP ---
PORT=8080
HOST=0.0.0.0
LOG_LEVEL=info
# Set behind a reverse proxy that terminates HTTPS, so the login cookie gets the Secure flag:
# the proxy's addresses/CIDRs (e.g. 172.16.0.0/12 for nginx on the Docker host), or true.
# Prefer addresses: with true, the logged client IP comes from X-Forwarded-For as sent.
# Only when the proxy is the sole way to reach the app; otherwise X-Forwarded-* can be spoofed.
# TRUST_PROXY=false

# --- Database ---
# pg: PostgreSQL (production, compose). pglite: embedded, for local development without a server.
DB_DRIVER=pglite
# Required when DB_DRIVER=pg. Compose example: postgres://dt:dt@db:5432/dt
# DATABASE_URL=postgres://dt:dt@localhost:5432/dt
# Data directory used when DB_DRIVER=pglite.
PGLITE_DIR=./data/pglite
# Override the migrations folder (the Docker image sets /app/drizzle).
# MIGRATIONS_DIR=

# --- Object storage (3D models) ---
# local: files under STORAGE_LOCAL_DIR. s3: any S3-compatible service (AWS S3, MinIO, ...).
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage
# Used when STORAGE_DRIVER=s3. Leave S3_ENDPOINT empty for AWS S3.
# With the compose `s3` profile: endpoint http://minio:9000, bucket dt-data,
# keys dtminio / dtminio-secret, path style true.
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Most self-hosted S3 services (MinIO) need true; AWS S3 uses false.
S3_FORCE_PATH_STYLE=false

# --- Admin account and sessions ---
# ADMIN_PASSWORD and SESSION_SECRET are required and intentionally left empty here:
# the server refuses to start until you set your own values.
ADMIN_USERNAME=admin
# At least 8 characters.
ADMIN_PASSWORD=
# At least 32 characters of random data. Generate one with: openssl rand -base64 48
SESSION_SECRET=

# --- Limits ---
# Maximum upload size of a 3D model, in MB.
MAX_MODEL_MB=500

# --- Web ---
# Directory of the built web app to serve (the Docker image sets /app/web).
# Leave unset in development; Vite serves the UI.
# WEB_DIST_DIR=
